<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>ETG 2026 - Car Racing</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#101827;color:white;font-family:Arial,sans-serif;text-align:center}
h2{margin:12px 0 6px;color:#ffd43b}#hud{display:flex;justify-content:space-around;max-width:520px;margin:8px auto;font-weight:bold}
canvas{display:block;margin:0 auto;background:#333;border:3px solid #ffd43b;border-radius:12px;width:min(94vw,420px);height:auto;touch-action:none}
#controls{display:flex;justify-content:center;gap:35px;margin:12px}
button{background:#ffd43b;color:#111;border:0;border-radius:14px;padding:14px 30px;font-size:22px;font-weight:bold}
#message{margin:8px;font-size:14px;color:#dbeafe}
</style>
</head>
<body>
<h2>🏁 ETG 2026 RACING</h2>
<div id="hud"><span>Score: <b id="score">0</b></span><span>Best: <b id="best">0</b></span></div>
<canvas id="game" width="360" height="600"></canvas>
<div id="controls">
<button id="left">◀ LEFT</button><button id="right">RIGHT ▶</button>
</div>
<div id="message">Tap START, then avoid the other cars!</div>
<script>
const c=document.getElementById('game'),ctx=c.getContext('2d');
const scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');
let best=Number(localStorage.getItem('etgBest')||0);bestEl.textContent=best;
let player={x:157,y:485,w:46,h:78},cars=[],score=0,speed=3.2,playing=false,spawn=0,roadShift=0;
const lanes=[77,157,237];
function car(x,y,color){return {x,y,w:46,h:78,color}}
function drawCar(o){
 ctx.fillStyle=o.color;ctx.fillRect(o.x,o.y,o.w,o.h);
 ctx.fillStyle='#111';ctx.fillRect(o.x+7,o.y+12,32,18);
 ctx.fillStyle='#bfe9ff';ctx.fillRect(o.x+9,o.y+14,28,13);
 ctx.fillStyle='#111';ctx.fillRect(o.x-4,o.y+12,5,18);ctx.fillRect(o.x+o.w-1,o.y+12,5,18);
 ctx.fillRect(o.x-4,o.y+52,5,18);ctx.fillRect(o.x+o.w-1,o.y+52,5,18);
 ctx.fillStyle='#ffe66d';ctx.fillRect(o.x+5,o.y+3,9,5);ctx.fillRect(o.x+32,o.y+3,9,5);
}
function road(){
 ctx.fillStyle='#287a3d';ctx.fillRect(0,0,360,600);
 ctx.fillStyle='#444';ctx.fillRect(35,0,290,600);
 ctx.fillStyle='#eee';ctx.fillRect(31,0,4,600);ctx.fillRect(325,0,4,600);
 ctx.strokeStyle='white';ctx.lineWidth=4;ctx.setLineDash([30,25]);
 ctx.lineDashOffset=-roadShift;ctx.beginPath();ctx.moveTo(132,0);ctx.lineTo(132,600);ctx.moveTo(228,0);ctx.lineTo(228,600);ctx.stroke();ctx.setLineDash([]);
}
function overlay(title,sub){
 ctx.fillStyle='rgba(0,0,0,.72)';ctx.fillRect(0,0,360,600);
 ctx.fillStyle='#ffd43b';ctx.textAlign='center';ctx.font='bold 30px Arial';ctx.fillText(title,180,255);
 ctx.fillStyle='white';ctx.font='16px Arial';ctx.fillText(sub,180,292);
 ctx.fillStyle='#ffd43b';ctx.fillRect(105,325,150,48);
 ctx.fillStyle='#111';ctx.font='bold 19px Arial';ctx.fillText('START',180,356);
}
function reset(){player.x=157;cars=[];score=0;speed=3.2;spawn=0;playing=true;scoreEl.textContent=0;document.getElementById('message').textContent='Avoid traffic and get the highest score!';}
function hit(a,b){return a.x+7<b.x+b.w-6&&a.x+a.w-7>b.x+6&&a.y+8<b.y+b.h-6&&a.y+a.h-8>b.y+6}
function end(){playing=false;if(score>best){best=score;localStorage.setItem('etgBest',best);bestEl.textContent=best;}}
function loop(){
 road();
 if(playing){
  roadShift+=speed;score+=1;scoreEl.textContent=Math.floor(score/10);
  spawn++;if(spawn>Math.max(28,65-speed*5)){spawn=0;let lane=lanes[Math.floor(Math.random()*3)];cars.push(car(lane, -90, ['#e63946','#3a86ff','#f77f00'][Math.floor(Math.random()*3)]));}
  cars.forEach(o=>o.y+=speed);
  cars=cars.filter(o=>o.y<650);
  cars.forEach(o=>{drawCar(o);if(hit(player,o))end();});
  drawCar(player);speed=Math.min(7,speed+0.0015);
 }else{
  drawCar(player);
  if(score===0)overlay('ETG 2026','Tap START to race');
  else overlay('GAME OVER','Score: '+Math.floor(score/10)+'  •  Tap START');
 }
 requestAnimationFrame(loop);
}
function move(d){if(playing)player.x=Math.max(42,Math.min(272,player.x+d*80));}
document.getElementById('left').addEventListener('pointerdown',()=>move(-1));
document.getElementById('right').addEventListener('pointerdown',()=>move(1));
c.addEventListener('pointerdown',e=>{if(!playing){reset();return;}let r=c.getBoundingClientRect(),x=e.clientX-r.left;if(x<r.width/2)move(-1);else move(1);});
window.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='a')move(-1);if(e.key==='ArrowRight'||e.key==='d')move(1);if(e.key==='Enter'&&!playing)reset();});
loop();
</script>
</body></html>
